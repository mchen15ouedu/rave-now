# Local simulator; no real SMS or WhatsApp messages are sent in demo mode.
APP_MODE=demo
HOST=127.0.0.1
PORT=8787
# Pin the offline message demonstration to a repeatable date.
# Ignored in live mode, which uses the current calendar date.
DEMO_DATE=2026-10-05

# Shared behavior. The 80-mile radius is an approximate two-hour proxy.
TIME_ZONE=America/Chicago
RADIUS_MILES=80
WINDOW_DAYS=7
REGISTRATION_KEYWORDS=INFO,SHOWS,START,JOIN

# Daily weekend reminders use the saved location's IANA time zone.
# The always-running worker checks once a minute, from 22:00 through 22:09.
REMINDERS_ENABLED=true
REMINDER_HOUR=22
REMINDER_GRACE_MINUTES=10
REMINDER_SEND_EMPTY=false
REMINDER_WEEKEND_POLICY=current

# Event source. Demo uses fictional local samples; live uses configured sources.
SPREADSHEET_ID=
# Optional numeric tab ID. Blank selects the generic SHEET_NAME below.
SHEET_ID=
SHEET_NAME=Upcoming Shows
SNAPSHOT_FILE=data/tracker-snapshot.tsv
DATABASE_PATH=work/show-finder.sqlite

# Required when APP_MODE=live. Fill these locally; never commit credentials.
# For deployment, also change HOST to 0.0.0.0 (or your reverse proxy bind address).
# Exact HTTPS URL entered in Twilio, including /webhooks/twilio.
PUBLIC_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Required in live mode when reminders are enabled.
# SMS example: +15551234567; WhatsApp example: whatsapp:+15551234567.
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# WhatsApp-approved Content Template SID (HX + 32 hex characters).
# Exact three-variable template and approval steps are in README.md.
WHATSAPP_REMINDER_CONTENT_SID=

# Google Cloud: enable Sheets API, Geocoding API, and Time Zone API.
# Share the private spreadsheet as Viewer with the service account email.
# Use an absolute path to the service-account JSON, or an attached cloud identity.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_MAPS_API_KEY=

# Hosted browser flow (independent of messaging credentials).
# Use `npm run browser`; browser port is independent of the simulator PORT above.
BROWSER_PORT=7860
BROWSER_SOURCE_MODE=snapshot
# Optional explicit HTTPS app origin behind a reverse proxy. Same-origin works
# without this setting. Use your deployment's origin, with no path or slash.
BROWSER_PUBLIC_ORIGIN=
# Optional capture date for a custom file. The bundled .meta.json takes priority.
BROWSER_SNAPSHOT_UPDATED_AT=
# Offline city / US ZIP centers, no geocoding API key required.
BROWSER_GEOCODER=cities
# Optional server-only artist catalog bridge; leave both blank for bundled names.
# Never place the key in browser code or a URL. See deploy/google/README.md.
ARTIST_CATALOG_URL=
ARTIST_CATALOG_SECRET=
# Messaging only: enable after sender credentials and durable storage are ready.
HOSTED_SERVICE_ENABLED=false

# Optional private HF text-feedback inbox (server only; no audio stored).
FEEDBACK_HF_REPO=
FEEDBACK_HF_TOKEN=

# Separate durable private artist/show submissions.
CONTRIBUTIONS_HF_REPO=
CONTRIBUTIONS_HF_TOKEN=
CONTRIBUTIONS_WORKER_ENABLED=false
# Batch mode uses a separate input-analysis Space; browser only saves input.
# Leave blank for the original processing-status workflow.
CONTRIBUTIONS_PROCESSING_MODE=
CONTRIBUTIONS_BATCH_INTERVAL_MINUTES=60
CONTRIBUTIONS_BATCH_LIMIT=20
# Processor-only configuration; see deploy/input-analysis/README.md.
INPUT_ANALYSIS_INTERVAL_MINUTES=60
INPUT_ANALYSIS_HF_REPO=
INPUT_ANALYSIS_HF_TOKEN=
# Optional model cache folder; keep it outside Git.
ARTIST_AI_CACHE_DIR=work/models

# Expired-show cleanup: enable only on the dedicated processor after a preview.
SHOW_EXPIRATION_ENABLED=false
SHOW_EXPIRATION_INTERVAL_MINUTES=15
SHOW_EXPIRATION_BROWSER_ORIGIN=
