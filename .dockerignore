# Keep the build context limited to the runtime source and dependency manifest.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!src/
!src/**
!public/
!public/**
!data/
!data/**
!scripts/
!scripts/**
!scripts/
!scripts/**

# Exclude credentials and runtime data even if placed in a source directory.
**/.env
**/.env.*
**/*credentials*.json
**/*token*.txt
**/*.pem
**/*.key
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/node_modules/
**/.git/

public/browser/vendor/
